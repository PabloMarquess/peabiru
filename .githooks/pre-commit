#!/bin/sh
set -eu

partial=$({ git diff --cached --name-only --diff-filter=ACMR; echo '--'; git diff --name-only; } | awk '/^--$/ { s = 1; next } !s { a[$0] = 1; next } a[$0]')
if [ -n "$partial" ]; then
  echo "pre-commit: these files have unstaged changes, so the checks would read a different version than the commit:" >&2
  # shellcheck disable=SC2086  # uma linha por arquivo, de propósito
  printf '  %s\n' $partial >&2
  echo "Stage them fully, or run 'git stash push --keep-index' to commit only what is staged." >&2
  exit 1
fi

cargo fmt --all -- --check
sh scripts/no-em-dash.sh --staged
sh scripts/gitleaks.sh --staged

staged=$(git diff --cached --name-only)
if printf '%s\n' "$staged" | grep -qE '\.sh$|^labs/kind/scenarios/'; then sh scripts/shellcheck.sh; fi
if printf '%s\n' "$staged" | grep -qE '^\.github/'; then sh scripts/workflows.sh; fi
