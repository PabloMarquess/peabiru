# Parâmetros do lab. Nomes e versões ficam aqui, fora dos scripts.

LAB_NAME=peabiru-lab
KIND_CONTEXT=kind-$LAB_NAME
KIND_NODE_IMAGE=            # vazio = imagem padrão da versão do kind instalada

PG_IMAGE=postgres:16.4-alpine
TOOLS_IMAGE=nicolaka/netshoot:v0.13
DNS_IMAGE=coredns/coredns:1.11.3

APP_NS=app
DB_NS=db
DB_PORT=5432                # porta em que os dois Postgres escutam

SVC_TARGET=postgres.$DB_NS.svc.cluster.local
RDS_ZONE=lab.internal
RDS_TARGET=orders-db.$RDS_ZONE

RDS_CONTAINER=$LAB_NAME-rds
RDS_FW_CONTAINER=$LAB_NAME-rds-fw
R53_CONTAINER=$LAB_NAME-r53

PROBE_TIMEOUT=3             # segundos por etapa da sonda
SETTLE_SECONDS=3            # espera depois de injetar ou reverter uma falha
